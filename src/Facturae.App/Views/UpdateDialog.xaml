<Window x:Class="Facturae.App.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Actualización disponible"
        Height="480" Width="640"
        MinHeight="360" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FF3F3F46" Padding="16,14">
            <StackPanel>
                <TextBlock Text="Nueva versión disponible" FontSize="18" FontWeight="SemiBold"
                           Foreground="White" />
                <TextBlock x:Name="VersionText" FontSize="13" Foreground="#FFD0D0D0" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#FFF0F0F0" BorderThickness="0,1,0,0"
                BorderBrush="#FFD0D0D0" Padding="12">
            <DockPanel>
                <Button x:Name="DownloadButton" DockPanel.Dock="Right" Content="Descargar e instalar"
                        Click="DownloadButton_Click" Padding="16,7" FontWeight="SemiBold" />
                <Button DockPanel.Dock="Right" Content="Más tarde" Click="CloseButton_Click"
                        Padding="16,7" Margin="0,0,8,0" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#FF616161"
                           TextWrapping="Wrap" Margin="0,0,12,0" />
            </DockPanel>
        </Border>

        <ScrollViewer Padding="16,12" Background="#FFFFFFFF" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Notas de la versión" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox x:Name="NotesTextBox" IsReadOnly="True" BorderThickness="0"
                         FontFamily="Segoe UI" FontSize="13" TextWrapping="Wrap"
                         Background="Transparent" Foreground="#FF1E1E1E" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
