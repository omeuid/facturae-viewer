<Window x:Class="Facturae.App.Views.PdfPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vista previa de impresión"
        Height="840" Width="820"
        MinHeight="520" MinWidth="640"
        WindowStartupLocation="CenterOwner">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FF3F3F46" Padding="10,8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="PrintButton" Content="Imprimir…" Click="PrintButton_Click"
                        Padding="14,5" FontWeight="SemiBold" />
                <Button Content="Cerrar" Click="CloseButton_Click" Padding="14,5" Margin="8,0,0,0" />
                <TextBlock x:Name="StatusText" Foreground="White" VerticalAlignment="Center"
                           Margin="14,0,0,0" Text="Preparando vista previa…" />
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="PageScroller" Background="#FFF0F0F0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel x:Name="PagesPanel" Margin="16" />
        </ScrollViewer>
    </DockPanel>
</Window>