<Window x:Class="Facturae.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Facturae.App.Converters"
        Title="Visor de FacturaE"
        Height="720" Width="1100"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Icon="Assets/App.ico"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <conv:StatusToBrushConverter x:Key="StatusToBrush" />
        <conv:StatusToGlyphConverter x:Key="StatusToGlyph" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:GreaterThanZeroToVisibilityConverter x:Key="GreaterThanZeroToVis" />
        <conv:BoolToCursorConverter x:Key="BoolToCursor" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de menús y herramientas -->
        <Border Grid.Row="0" Background="#FF3F3F46" Padding="0">
            <StackPanel>
                <Menu Background="#FFFFFFFF" Foreground="#FF1E1E1E" Padding="4,2">
                    <MenuItem Header="Archivo">
                        <MenuItem Header="Abrir…" Command="{Binding OpenCommand}" />
                        <MenuItem Header="Salir" Click="ExitMenu_Click" />
                    </MenuItem>
                    <MenuItem x:Name="RecentsMenu" Header="Recientes">
                        <MenuItem Header="(vacío)" IsEnabled="False" />
                    </MenuItem>
                </Menu>
                <Border Padding="10,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Content="Abrir…"
                                Command="{Binding OpenCommand}"
                                Padding="14,5" FontWeight="SemiBold"
                                ToolTip="Abrir un fichero .xsig, .xpsig o .xml" />

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Facturas:"
                                       Foreground="#FFD0D0D0" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button Content="‹" Command="{Binding GoPreviousCommand}"
                                    ToolTip="Factura anterior" Width="32" FontSize="16" Margin="0,0,4,0" />
                            <TextBlock VerticalAlignment="Center" Foreground="White" Margin="0,0,4,0">
                                <Run Text="{Binding CurrentDisplayIndex, Mode=OneWay}" />
                                <Run Text="/" />
                                <Run Text="{Binding TotalInvoices, Mode=OneWay}" />
                            </TextBlock>
                            <Button Content="›" Command="{Binding GoNextCommand}"
                                    ToolTip="Factura siguiente" Width="32" FontSize="16" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,16,0">
                            <Button Content="Exportar a PDF…" Command="{Binding ExportPdfCommand}"
                                    Padding="14,5" Margin="0,0,8,0"
                                    ToolTip="Guardar la factura actual como documento PDF" />
                            <Button Content="Imprimir…" Command="{Binding PrintCommand}"
                                    Padding="14,5"
                                    ToolTip="Vista previa e impresión de la factura actual" />
                        </StackPanel>

                        <TextBlock Text="{Binding FileName}" Foreground="White"
                                   FontWeight="SemiBold" FontSize="14"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Contenido -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- Estado vacío -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                        Visibility="{Binding HasDocument, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Text="Visor de FacturaE"
                           FontSize="34" FontWeight="Bold"
                           HorizontalAlignment="Center" Foreground="#FF9E9E9E" />
                <TextBlock Text="{Binding SummaryText}"
                           FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           MaxWidth="420" Foreground="#FF757575" />
            </StackPanel>

            <!-- Carga en curso -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <ProgressBar IsIndeterminate="True" Width="260" Height="6" Margin="0,0,0,10" />
                <TextBlock Text="Abriendo y validando el documento…"
                           FontSize="15" HorizontalAlignment="Center" Foreground="#FF616161" />
            </StackPanel>

            <!-- Factura visual y XML -->
            <TabControl Grid.Column="0" Background="#FFF7F7F7"
                        SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                        Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">
                <TabItem Header="Factura">
                    <ScrollViewer Background="#FFF7F7F7"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,20" DataContext="{Binding CurrentInvoice}">

                    <!-- Cabecera -->
                    <Border Background="White" Padding="20,16" CornerRadius="6"
                            BorderBrush="#FFDDDDDD" BorderThickness="1">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="FACTURA" FontSize="12" FontWeight="Bold"
                                           Foreground="#FF757575" VerticalAlignment="Center" />
                                <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold"
                                           FontSize="13" Foreground="#FF616161">
                                    <Run Text="{Binding CurrencyCode, Mode=OneWay}" />
                                </TextBlock>
                            </DockPanel>
                            <TextBlock FontSize="26" FontWeight="Bold" Margin="0,4,0,10">
                                <Run Text="{Binding SeriesCode, Mode=OneWay}" />
                                <Run Text="{Binding InvoiceNumber, Mode=OneWay}" />
                            </TextBlock>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Tipo de documento"
                                           Foreground="#FF757575" FontSize="11" />
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding DocumentTypeText, Mode=OneWay}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Clase de factura"
                                           Foreground="#FF757575" FontSize="11" />
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding InvoiceClassText, Mode=OneWay}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Fecha de emisión"
                                           Foreground="#FF757575" FontSize="11" />
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="{Binding IssueDate, Mode=OneWay}" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Fecha de operación"
                                           Foreground="#FF757575" FontSize="11" />
                                <TextBlock Grid.Row="3" Grid.Column="1"
                                           Text="{Binding OperationDate, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Emisor y receptor -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" Padding="14,12" CornerRadius="6"
                                BorderBrush="#FFDDDDDD" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="EMISOR" FontSize="11" FontWeight="Bold"
                                           Foreground="#FF757575" />
                                <TextBlock Text="{Binding Seller.Name, Mode=OneWay}" FontWeight="SemiBold"
                                           FontSize="15" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Seller.TaxId, Mode=OneWay}"
                                           Foreground="#FF2E7D32" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding Seller.FullAddress, Mode=OneWay}"
                                           Foreground="#FF616161" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="White" Padding="14,12" CornerRadius="6"
                                BorderBrush="#FFDDDDDD" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="RECEPTOR" FontSize="11" FontWeight="Bold"
                                           Foreground="#FF757575" />
                                <TextBlock Text="{Binding Buyer.Name, Mode=OneWay}" FontWeight="SemiBold"
                                           FontSize="15" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Buyer.TaxId, Mode=OneWay}"
                                           Foreground="#FF2E7D32" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding Buyer.FullAddress, Mode=OneWay}"
                                           Foreground="#FF616161" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Líneas de detalle -->
                    <Border Background="White" Padding="14,12" CornerRadius="6" Margin="0,12,0,0"
                            BorderBrush="#FFDDDDDD" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Líneas de detalle" FontSize="12" FontWeight="Bold"
                                       Foreground="#FF757575" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Descripción" FontWeight="SemiBold" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="Cantidad" FontWeight="SemiBold" FontSize="11"
                                           HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="Precio unitario" FontWeight="SemiBold" FontSize="11"
                                           HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="Total" FontWeight="SemiBold" FontSize="11"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Lines, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="0,0,0,1" BorderBrush="#FFECECEC" Padding="0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Description, Mode=OneWay}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" TextAlignment="Right">
                                                    <Run Text="{Binding Quantity, Mode=OneWay, StringFormat={}{0:N2}}" />
                                                    <Run Text="{Binding UnitOfMeasureText, Mode=OneWay}" FontSize="10"
                                                         Foreground="#FF9E9E9E" />
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" TextAlignment="Right"
                                                           Text="{Binding UnitPriceWithoutTax, Mode=OneWay, StringFormat={}{0:N2}}" />
                                                <TextBlock Grid.Column="3" TextAlignment="Right" FontWeight="SemiBold"
                                                           Text="{Binding GrossAmount, Mode=OneWay, StringFormat={}{0:N2}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Impuestos -->
                    <Border Background="White" Padding="14,12" CornerRadius="6" Margin="0,12,0,0"
                            BorderBrush="#FFDDDDDD" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Impuestos" FontSize="12" FontWeight="Bold"
                                       Foreground="#FF757575" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding TaxOutputs, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0">
                                                <Run Text="{Binding TaxTypeText, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="{Binding Rate, Mode=OneWay, StringFormat=({0:P2})}"
                                                     Foreground="#FF616161" />
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" TextAlignment="Right"
                                                       Text="{Binding TaxableBase, Mode=OneWay, StringFormat={}{0:N2}}" />
                                            <TextBlock Grid.Column="2" TextAlignment="Right"
                                                       Text="{Binding TaxAmount, Mode=OneWay, StringFormat={}{0:N2}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding TaxesWithheld, Mode=OneWay}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0">
                                                <Run Text="Retención " Foreground="#FF616161" />
                                                <Run Text="{Binding TaxTypeText, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="{Binding Rate, Mode=OneWay, StringFormat=({0:P2})}"
                                                     Foreground="#FF616161" />
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" TextAlignment="Right"
                                                       Text="{Binding TaxableBase, Mode=OneWay, StringFormat={}{0:N2}}" />
                                            <TextBlock Grid.Column="2" TextAlignment="Right"
                                                       Text="{Binding TaxAmount, Mode=OneWay, StringFormat={}{0:N2}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Condiciones de pago -->
                    <Border Background="White" Padding="14,12" CornerRadius="6" Margin="0,12,0,0"
                            BorderBrush="#FFDDDDDD" BorderThickness="1"
                            Visibility="{Binding Payments.Count, Converter={StaticResource GreaterThanZeroToVis}}">
                        <StackPanel>
                            <TextBlock Text="Condiciones de pago" FontSize="12" FontWeight="Bold"
                                       Foreground="#FF757575" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Payments, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DueDate, Mode=OneWay}" />
                                            <TextBlock Grid.Column="1" Text="{Binding PaymentMeansText, Mode=OneWay}" />
                                            <TextBlock Grid.Column="2" TextAlignment="Right"
                                                       Text="{Binding Amount, Mode=OneWay, StringFormat={}{0:N2}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Totales -->
                    <Border Background="White" Padding="14,12" CornerRadius="6" Margin="0,12,0,0"
                            BorderBrush="#FFDDDDDD" BorderThickness="1" HorizontalAlignment="Right" MinWidth="340">
                        <StackPanel>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Base imponible" />
                                <TextBlock Grid.Column="1" TextAlignment="Right"
                                           Text="{Binding Totals.GrossAmount, Mode=OneWay, StringFormat={}{0:N2}}" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Descuentos y recargos" />
                                <TextBlock Grid.Column="1" TextAlignment="Right"
                                           Text="{Binding Totals.GeneralDiscounts, Mode=OneWay, StringFormat={}{0:N2}}" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Cuota impositiva" />
                                <TextBlock Grid.Column="1" TextAlignment="Right"
                                           Text="{Binding Totals.TaxOutputs, Mode=OneWay, StringFormat={}{0:N2}}" />
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Retenciones" />
                                <TextBlock Grid.Column="1" TextAlignment="Right"
                                           Text="{Binding Totals.TaxesWithheld, Mode=OneWay, StringFormat={}{0:N2}}" />
                            </Grid>
                            <Border BorderThickness="0,1,0,0" BorderBrush="#FFD0D0D0" Margin="0,8,0,0" Padding="0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="TOTAL FACTURA" FontSize="15" FontWeight="Bold" />
                                    <TextBlock Grid.Column="1" TextAlignment="Right" FontSize="15" FontWeight="Bold">
                                        <Run Text="{Binding Totals.InvoiceTotal, Mode=OneWay, StringFormat={}{0:N2}}" />
                                        <Run Text="{Binding CurrencyCode, Mode=OneWay}" FontSize="11" />
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Pendiente de cobro" FontSize="12"
                                           Foreground="#FF616161" />
                                <TextBlock Grid.Column="1" TextAlignment="Right" FontSize="12"
                                           Foreground="#FF616161"
                                           Text="{Binding Totals.TotalOutstandingAmount, Mode=OneWay, StringFormat={}{0:N2}}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Firma electrónica -->
                    <Border Background="White" Padding="14,12" CornerRadius="6" Margin="0,12,0,0"
                            BorderBrush="#FFDDDDDD" BorderThickness="1"
                            DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel>
                            <TextBlock Text="Firma electrónica" FontSize="12" FontWeight="Bold"
                                       Foreground="#FF757575" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Tipo"
                                           Foreground="#FF757575" FontSize="11" />
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding Signature.TypeText, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Fecha de firma"
                                           Foreground="#FF757575" FontSize="11" Margin="0,4,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4,0,0"
                                           Text="{Binding Signature.SigningTime, Mode=OneWay}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Política"
                                           Foreground="#FF757575" FontSize="11" Margin="0,4,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4,0,0"
                                           Text="{Binding Signature.Policy, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Rol"
                                           Foreground="#FF757575" FontSize="11" Margin="0,4,0,0" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4,0,0"
                                           Text="{Binding Signature.ClaimedRole, Mode=OneWay}" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Certificado"
                                           Foreground="#FF757575" FontSize="11" Margin="0,4,0,0" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,4,0,0"
                                           Text="{Binding Signature.CertificateSubject, Mode=OneWay}"
                                           TextWrapping="Wrap" />
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Validez"
                                           Foreground="#FF757575" FontSize="11" Margin="0,4,0,0" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,4,0,0"
                                           Text="{Binding Signature.CertificateValidPeriod, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="XML">
                    <TextBox x:Name="XmlTextBox" Text="{Binding RawXml, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="12"
                             Background="#FFFFFFFF" Foreground="#FF1E1E1E"
                             BorderThickness="0" Padding="12"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" />
                </TabItem>
            </TabControl>

            <!-- Panel de validación -->
            <Border Grid.Column="1" Background="#FFF0F0F0" BorderThickness="1,0,0,0" BorderBrush="#FFD0D0D0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FF2B2B2B" Padding="12,12">
                        <StackPanel>
                            <TextBlock Text="Validación" FontSize="10" FontWeight="Bold"
                                       Foreground="#FF9E9E9E" />
                            <TextBlock Text="{Binding DocumentStateText}" FontSize="21" FontWeight="SemiBold"
                                       Foreground="{Binding OverallStatus, Converter={StaticResource StatusToBrush}}"
                                       Margin="0,3,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SummaryText}" Foreground="#FFD0D0D0" FontSize="12" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Checks}" Margin="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Background="#33FFFFFF" BorderThickness="0" Padding="8,6" Margin="0,3"
                                        HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"
                                        Command="{Binding DataContext.NavigateToCheckCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Cursor="{Binding CanNavigate, Converter={StaticResource BoolToCursor}}"
                                        ToolTip="Ver el nodo en la pestaña XML">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                    </Button.Resources>
                                    <DockPanel>
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusToGlyph}}"
                                                   DockPanel.Dock="Left" FontWeight="Bold" Width="20"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                        <TextBlock Text="{Binding Code}" DockPanel.Dock="Left" FontWeight="SemiBold"
                                                   FontSize="12" Margin="0,0,8,0"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                        <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="#FF333333" />
                                        <TextBlock Text="▸" DockPanel.Dock="Right" Foreground="#FF2E7D32"
                                                   FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding CanNavigate, Converter={StaticResource BoolToVis}}" />
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Barra de estado -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding SchemaVersion}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <!-- Superposición de arrastre -->
        <!-- IsHitTestVisible=False: evita que el overlay altere el hit-test bajo
             el ratón durante el arrastre y provoque DragEnter/DragLeave alternados
             (parpadeo del recuadro). -->
        <Border Grid.Row="1" Background="#B8FFFFFF" IsHitTestVisible="False"
                Visibility="{Binding IsDragOver, Converter={StaticResource BoolToVis}}">
            <Border BorderBrush="#FF2E7D32" BorderThickness="3" CornerRadius="10"
                    Background="#EEFFFFFF" Margin="24">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Suelte el fichero para validarlo" FontSize="24" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Foreground="#FF2E7D32" />
                    <TextBlock Text="(.xsig, .xpsig o .xml)" FontSize="13" HorizontalAlignment="Center"
