<Project>

  <PropertyGroup>
    <!-- Configuración común a todos los proyectos. -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- Por defecto net10.0; la app WPF usa net10.0-windows. -->
    <TargetFramework>net10.0</TargetFramework>
    <TargetFramework Condition="'$(MSBuildProjectName)' == 'Facturae.App'">net10.0-windows</TargetFramework>

    <!-- WPF habilitado solo donde se necesita. -->
    <UseWPF Condition="'$(MSBuildProjectName)' == 'Facturae.App'">true</UseWPF>

    <!-- Metadatos del paquete/repo. -->
    <Version>0.1.0</Version>
    <Authors>Facturae Viewer contributors</Authors>
    <Product>Facturae Viewer</Product>
    <Copyright>Copyright (c) 2026 Facturae Viewer contributors</Copyright>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>