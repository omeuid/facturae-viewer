<Project>

  <PropertyGroup>
    <!-- Configuración común a todos los proyectos. -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- Por defecto net10.0; la app WPF declara net10.0-windows y UseWPF en su propio csproj. -->
    <TargetFramework>net10.0</TargetFramework>

    <!-- Metadatos del paquete/repo. -->
    <Version>1.0.0</Version>
    <Authors>Facturae Viewer contributors</Authors>
    <Product>Facturae Viewer</Product>
    <Copyright>Copyright (c) 2026 Facturae Viewer contributors</Copyright>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>